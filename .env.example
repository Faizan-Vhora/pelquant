# Endpoint every form on the site posts to. See src/formEndpoint.js.
#
# This value is inlined into the client bundle at build time, so it is public.
# Set it to a FormSubmit alias (activate the form once and FormSubmit issues a
# random endpoint) or to your own deployed function — either keeps the
# destination address out of the published JavaScript.
VITE_FORM_ENDPOINT=https://formsubmit.co/ajax/your-alias-here
